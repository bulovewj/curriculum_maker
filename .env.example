# 복사해서 .env.local 로 쓴다(.env.local 은 git에 올라가지 않는다). 키는 브라우저 코드에 넣지 않는다(VITE_ 접두사 금지).
# 둘 중 하나만 넣으면 된다(둘 다 있으면 Claude). GPT를 쓰면 아래 모델 이름을 GPT 모델로 바꾼다(예: gpt-4o-mini).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5

# --- 배포(Vercel)용 ---
# 접속 비밀번호: Vercel 환경변수에만 넣는다(코드·git에 쓰지 않는다). 없으면 Vercel에서는 AI 호출을 막는다.
APP_PASSWORD=
# GitHub Pages에서 이 서버를 부를 때 허용할 주소(쉼표로 여러 개): https://bulovewj.github.io
ALLOWED_ORIGIN=
